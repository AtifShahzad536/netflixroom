        </p>
        <textarea id="broadcast-message-text" rows="4" placeholder="Enter message to broadcast to chat in real-time..."></textarea>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="closeBroadcastModal()">Cancel</button>
        <button class="btn btn-primary" onclick="submitBroadcast()"><i data-lucide="send"></i> Send Broadcast</button>
      </div>
    </div>
  </div>

  <!-- =========================================================================
       REAL-TIME DASHBOARD LOGIC & JAVASCRIPT
       ========================================================================= -->
  <script>
    if (window.lucide) {
      lucide.createIcons();
    }

    // Live Clock
    function updateClock() {
      const now = new Date();
      document.getElementById('clock-display').innerText = now.toLocaleTimeString();
    }
    setInterval(updateClock, 1000);
    updateClock();

    // Tab Navigation
    function switchNavTab(tabId) {
      const tabs = ['dashboard', 'parties', 'users', 'voice', 'chat', 'broadcast', 'audit', 'settings'];
      
      tabs.forEach(t => {
        const view = document.getElementById('view-' + t);
        if (view) view.classList.remove('active-view');
      });

      const buttons = document.querySelectorAll('.nav-tab-btn');
      buttons.forEach(btn => btn.classList.remove('active'));

      const targetView = document.getElementById('view-' + tabId);
      if (targetView) targetView.classList.add('active-view');

      // Set active on matching button
      buttons.forEach(btn => {
        if (btn.getAttribute('onclick')?.includes(tabId)) {
          btn.classList.add('active');
        }
      });

      if (window.lucide) lucide.createIcons();
    }

    // =========================================================================
    // CHART.JS INITIALIZATION
    // =========================================================================
    const trafficCtx = document.getElementById('trafficChart').getContext('2d');
    const titlesCtx = document.getElementById('titlesChart').getContext('2d');

    const maxHistoryPoints = 15;
    const timeLabels = [];
    const membersData = [];
    const voiceData = [];

    for (let i = maxHistoryPoints - 1; i >= 0; i--) {
      const t = new Date(Date.now() - i * 3000);
      timeLabels.push(t.toLocaleTimeString());
      membersData.push(<%= stats.totalMembers %>);
      voiceData.push(<%= stats.totalVoiceUsers %>);
    }

    const trafficChart = new Chart(trafficCtx, {
      type: 'line',
      data: {
        labels: timeLabels,
        datasets: [
          {
            label: 'Connected Members',
            data: membersData,
            borderColor: '#38bdf8',
            backgroundColor: 'rgba(56, 189, 248, 0.1)',
            borderWidth: 2,
            tension: 0.35,
            fill: true,
            pointRadius: 3
          },
          {
            label: 'WebRTC Voice Streams',
            data: voiceData,
            borderColor: '#10b981',
            backgroundColor: 'rgba(16, 185, 129, 0.08)',
            borderWidth: 2,
            tension: 0.35,
            fill: true,
            pointRadius: 3
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            labels: { color: '#cbd5e1', font: { family: 'Outfit', size: 11 } }
          }
        },
        scales: {
          x: {
            grid: { color: 'rgba(255, 255, 255, 0.04)' },
            ticks: { color: '#64748b', font: { size: 10 } }
          },
          y: {
            beginAtZero: true,
            grid: { color: 'rgba(255, 255, 255, 0.04)' },
            ticks: { color: '#64748b', precision: 0 }
          }
        }
      }
    });

    const titleLabels = Object.keys(<%- JSON.stringify(stats.titleBreakdown || {}) %>);
    const titleCounts = Object.values(<%- JSON.stringify(stats.titleBreakdown || {}) %>);

    const titlesChart = new Chart(titlesCtx, {
      type: 'doughnut',
      data: {
        labels: titleLabels.length ? titleLabels : ['No Active Stream'],
        datasets: [{
          data: titleCounts.length ? titleCounts : [1],
          backgroundColor: ['#E50914', '#38bdf8', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899'],
          borderColor: '#0e1118',
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom',
            labels: { color: '#cbd5e1', font: { family: 'Outfit', size: 10 }, boxWidth: 12 }
          }
        }
      }
    });

    // =========================================================================
    // REAL-TIME AUTO-REFRESH & DATA FETCHING
    // =========================================================================
    async function fetchStats() {
      try {
        const res = await fetch('/user/admin/access/api/stats');
        if (!res.ok) {
          if (res.status === 401) {
            window.location.href = '/user/admin/login';
          }
          return;
        }
        const data = await res.json();
        renderDashboard(data);
      } catch (err) {
        console.error('Failed to poll admin stats:', err);
      }
    }

    function renderDashboard(data) {
      // Update KPIs & Sidebar counters
      document.getElementById('kpi-parties').innerText = data.totalParties;
      document.getElementById('kpi-members').innerText = data.totalMembers;
      document.getElementById('kpi-voice').innerText = data.totalVoiceUsers;
      document.getElementById('kpi-messages').innerText = data.totalMessages;
      document.getElementById('kpi-playing').innerHTML = `${data.playingCount} <span style="font-size: 0.9rem; color: var(--text-dark);">/ ${data.pausedCount} paused</span>`;
      document.getElementById('kpi-memory').innerText = `${data.memoryMb} MB`;

      document.getElementById('side-parties-count').innerText = data.totalParties;
      document.getElementById('side-members-count').innerText = data.totalMembers;
      document.getElementById('side-voice-count').innerText = data.totalVoiceUsers;
      document.getElementById('side-messages-count').innerText = data.totalMessages;
      document.getElementById('parties-count-tab').innerText = data.totalParties;

      // Update Chart
      const nowStr = new Date().toLocaleTimeString();
      trafficChart.data.labels.push(nowStr);
      trafficChart.data.datasets[0].data.push(data.totalMembers);
      trafficChart.data.datasets[1].data.push(data.totalVoiceUsers);

      if (trafficChart.data.labels.length > maxHistoryPoints) {
        trafficChart.data.labels.shift();
        trafficChart.data.datasets[0].data.shift();
        trafficChart.data.datasets[1].data.shift();
      }
      trafficChart.update('none');

      // Update Titles Chart
      const tLabels = Object.keys(data.titleBreakdown || {});
      const tCounts = Object.values(data.titleBreakdown || {});
      titlesChart.data.labels = tLabels.length ? tLabels : ['No Active Stream'];
      titlesChart.data.datasets[0].data = tCounts.length ? tCounts : [1];
      titlesChart.update('none');

      // Render Parties Grid
      renderParties(data.rooms || []);

      // Render Users Table
      renderUsersTable(data.rooms || []);

      // Render Voice Table
      renderVoiceTable(data.rooms || []);

      // Render Audit Table
      renderAuditTable(data.recentEvents || []);

      // Render Chat Stream
      renderChatStream(data.recentMessages || []);

      // Update Broadcast Target Dropdown
      updateBroadcastOptions(data.rooms || []);
    }

    function renderChatStream(messages) {
      const container = document.getElementById('chat-stream-container');
      if (!container) return;

      if (!messages || messages.length === 0) {
        container.innerHTML = `
          <div style="text-align: center; padding: 40px; border: 1px dashed var(--border-subtle); color: var(--text-muted);">
            <i data-lucide="message-circle" style="width: 32px; height: 32px; color: var(--text-dark); margin-bottom: 8px;"></i>
            <h4>No Live Chat Messages Sent Yet</h4>
            <p style="font-size: 0.8rem; margin-top: 4px;">When users type messages or react with stickers in watch parties, they will stream here in real-time.</p>
          </div>
        `;
        if (window.lucide) lucide.createIcons();
        return;
      }

      let html = '';
      messages.forEach(msg => {
        const isSystem = msg.type === 'system' || msg.type === 'action' || msg.senderId === 'system' || msg.senderId === 'admin';
        const isSticker = !!msg.stickerUrl;
        const timeStr = msg.timestamp ? new Date(msg.timestamp).toLocaleTimeString() : '';

        if (isSystem) {
          html += `
            <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(56, 189, 248, 0.2); padding: 8px 12px; display: flex; align-items: center; justify-content: space-between; font-size: 0.78rem;">
              <div style="display: flex; align-items: center; gap: 8px;">
                <span class="room-code-badge" style="font-size: 0.68rem; padding: 1px 5px;">${msg.partyCode || 'GLOBAL'}</span>
                <span class="badge badge-blue">⚙️ System</span>
                <span style="color: #94a3b8; font-style: italic;">${msg.text}</span>
              </div>
              <span style="font-family: monospace; font-size: 0.7rem; color: var(--text-dark);">${timeStr}</span>
            </div>
          `;
        } else {
          html += `
            <div style="background: var(--bg-inner); border: 1px solid var(--border-subtle); padding: 10px 14px; display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;">
              <div style="display: flex; align-items: flex-start; gap: 10px;">
                <div style="width: 28px; height: 28px; background: #1e293b; color: #38bdf8; font-weight: 800; font-size: 0.75rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                  ${(msg.senderName || 'U').charAt(0).toUpperCase()}
                </div>
                <div>
                  <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 2px;">
                    <strong style="color: #fff; font-size: 0.82rem;">${msg.senderName || 'User'}</strong>
                    <span class="room-code-badge" style="font-size: 0.65rem; padding: 1px 5px;">${msg.partyCode}</span>
                  </div>
                  <div style="font-size: 0.82rem; color: #cbd5e1; word-break: break-word;">
                    ${msg.text || ''}
                    ${isSticker ? `<span class="badge badge-amber" style="margin-left: 4px;">🎬 Reaction Sticker</span>` : ''}
                  </div>
                </div>
              </div>
              <span style="font-family: monospace; font-size: 0.7rem; color: var(--text-dark); flex-shrink: 0;">${timeStr}</span>
            </div>
          `;
        }
      });

      container.innerHTML = html;
      if (window.lucide) lucide.createIcons();
    }

    function renderParties(rooms) {
      const container = document.getElementById('parties-container');
      if (!rooms || rooms.length === 0) {
        container.innerHTML = `
          <div style="grid-column: 1 / -1; text-align: center; padding: 40px; border: 1px dashed var(--border-subtle); color: var(--text-muted);">
            <i data-lucide="tv-2" style="width: 36px; height: 36px; color: var(--text-dark); margin-bottom: 8px;"></i>
            <h4>No Active Watch Parties Right Now</h4>
            <p style="font-size: 0.82rem; margin-top: 4px;">When users create parties in the extension, they will appear here in real-time.</p>
          </div>
        `;
        if (window.lucide) lucide.createIcons();
        return;
      }

      let html = '';
      rooms.forEach(room => {
        const isPlaying = room.playbackState && room.playbackState.isPlaying;
        const curTime = room.playbackState ? Math.floor(room.playbackState.currentTime) : 0;

        let membersHtml = '';
        (room.members || []).forEach(m => {
          membersHtml += `
            <div class="member-mini-item">
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="font-weight: 700; color: #fff;">${m.name}</span>
                ${m.isHost ? '<span class="badge badge-red">👑 Host</span>' : '<span class="badge badge-slate">Member</span>'}
                ${m.inVoice ? '<span class="badge badge-green">🎙️ Voice</span>' : ''}
              </div>
              ${!m.isHost ? `
                <button class="btn btn-danger" style="padding: 2px 6px; font-size: 0.65rem;" onclick="kickMember('${room.partyCode}', '${m.userId}', '${m.name}')">Kick</button>
              ` : ''}
            </div>
          `;
        });

        html += `
          <div class="room-card" data-code="${room.partyCode}" data-title="${room.mediaInfo?.title || ''}" data-host="${room.hostName}">
            <div class="room-card-head">
              <div>
                <h4 style="font-size: 1.05rem; font-weight: 800; color: #fff;">${room.name}</h4>
                <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;">
                  Host: <strong>${room.hostName}</strong> • ${room.memberCount} Members • ${room.voiceCount} in Voice
                </div>
              </div>
              <span class="room-code-badge">${room.partyCode}</span>
            </div>

            <div style="background: var(--bg-inner); border: 1px solid var(--border-subtle); padding: 10px 12px; display: flex; align-items: center; justify-content: space-between;">
              <span style="font-size: 0.82rem; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 6px;">
                <i data-lucide="film" style="color: var(--primary); width: 15px; height: 15px;"></i>
                ${room.mediaInfo?.title || 'Netflix Stream'}
              </span>
              <span class="badge ${isPlaying ? 'badge-green' : 'badge-amber'}">
                ${isPlaying ? '▶ Playing' : '⏸ Paused'} (${curTime}s)
              </span>
            </div>

            <div>
              <div style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px;">
                Joined Members (${room.memberCount})
              </div>
              <div class="members-mini-list">
                ${membersHtml}
              </div>
            </div>

            <div style="display: flex; align-items: center; justify-content: space-between; padding-top: 10px; border-top: 1px solid rgba(255,255,255,0.05);">
              <button class="btn btn-secondary" style="font-size: 0.72rem; padding: 5px 10px;" onclick="openBroadcastModal('${room.partyCode}')">
                <i data-lucide="message-circle"></i> Send Notice
              </button>
              <button class="btn btn-danger" style="font-size: 0.72rem; padding: 5px 10px;" onclick="terminateParty('${room.partyCode}')">
                <i data-lucide="x-circle"></i> End Party
              </button>
            </div>
          </div>
        `;
      });

      container.innerHTML = html;
      if (window.lucide) lucide.createIcons();
    }

    function renderUsersTable(rooms) {
      const tbody = document.getElementById('users-table-body');
      let html = '';

      rooms.forEach(room => {
        (room.members || []).forEach(m => {
          html += `
            <tr>
              <td>
                <div style="display: flex; align-items: center; gap: 8px;">
                  <div style="width: 24px; height: 24px; background: ${m.isHost ? 'var(--primary)' : '#252b3d'}; color: #fff; font-weight: 800; font-size: 0.7rem; display: flex; align-items: center; justify-content: center;">
                    ${(m.name || 'U').charAt(0).toUpperCase()}
                  </div>
                  <strong style="color: #fff;">${m.name}</strong>
                </div>
              </td>
              <td style="font-family: monospace; font-size: 0.75rem; color: var(--text-muted);">${m.userId}</td>
              <td><span class="room-code-badge" style="font-size: 0.75rem;">${room.partyCode}</span></td>
              <td>${m.isHost ? '<span class="badge badge-red">👑 Host</span>' : '<span class="badge badge-slate">Member</span>'}</td>
              <td>${m.inVoice ? '<span class="badge badge-green">🎙️ In Voice</span>' : '<span class="badge badge-slate">Off</span>'}</td>
              <td style="font-family: monospace; font-size: 0.75rem; color: var(--text-dark);">${m.socketId || 'Connected'}</td>
              <td>
                ${!m.isHost ? `
                  <button class="btn btn-danger" style="padding: 3px 8px; font-size: 0.7rem;" onclick="kickMember('${room.partyCode}', '${m.userId}', '${m.name}')">Kick</button>
                ` : '<span style="font-size: 0.7rem; color: var(--text-dark);">Host</span>'}
              </td>
            </tr>
          `;
        });
      });

      if (!html) {
        html = '<tr><td colspan="7" style="text-align: center; padding: 20px; color: var(--text-dark);">No connected users online.</td></tr>';
      }
      tbody.innerHTML = html;
    }

    function renderVoiceTable(rooms) {
      const tbody = document.getElementById('voice-table-body');
      let html = '';

      rooms.forEach(room => {
        (room.members || []).filter(m => m.inVoice).forEach(m => {
          html += `
            <tr>
              <td><strong style="color: #fff;">${m.name}</strong></td>
              <td><span class="room-code-badge" style="font-size: 0.75rem;">${room.partyCode}</span></td>
              <td>${m.isMuted ? '<span class="badge badge-slate">🔇 Muted</span>' : '<span class="badge badge-green">🟢 Unmuted / Mic Open</span>'}</td>
              <td><span class="badge badge-blue">Formant VAD Active</span></td>
              <td><span class="badge badge-green">260Hz - 3200Hz Clean Pass</span></td>
            </tr>
          `;
        });
      });

      if (!html) {
        html = '<tr><td colspan="5" style="text-align: center; padding: 20px; color: var(--text-dark);">No members currently in WebRTC Voice mesh.</td></tr>';
      }
      tbody.innerHTML = html;
    }

    function renderAuditTable(events) {
      const tbody = document.getElementById('audit-table-body');
      if (!events || events.length === 0) {
        tbody.innerHTML = '<tr><td colspan="3" style="text-align: center; padding: 20px; color: var(--text-dark);">No audit events recorded yet.</td></tr>';
        return;
      }

      let html = '';
      events.forEach(evt => {
        html += `
          <tr>
            <td><span class="badge badge-red">${evt.type}</span></td>
            <td style="color: #cbd5e1; font-weight: 600;">${evt.title}</td>
            <td style="font-family: monospace; font-size: 0.75rem; color: var(--text-dark);">${new Date(evt.timestamp).toLocaleString()}</td>
          </tr>
        `;
      });
      tbody.innerHTML = html;
    }

    function updateBroadcastOptions(rooms) {
      const select = document.getElementById('tab-broadcast-target');
      if (!select) return;
      let html = '<option value="ALL">🌐 Global Broadcast (All Active Watch Parties)</option>';
      rooms.forEach(r => {
        html += `<option value="${r.partyCode}">Party: ${r.partyCode} (${r.name})</option>`;
      });
      select.innerHTML = html;
    }

    // Auto-polling interval (3 seconds)
    setInterval(fetchStats, 3000);
    fetchStats();

    function triggerManualRefresh() {
      const btn = document.getElementById('refresh-btn');
      btn.style.opacity = '0.5';
      fetchStats().finally(() => {
        btn.style.opacity = '1';
      });
    }

    // Global Search
    function handleGlobalSearch() {
      const q = document.getElementById('global-search').value.toLowerCase().trim();
      const cards = document.querySelectorAll('.room-card');
      cards.forEach(card => {
        const code = (card.dataset.code || '').toLowerCase();
        const title = (card.dataset.title || '').toLowerCase();
        const host = (card.dataset.host || '').toLowerCase();
        if (!q || code.includes(q) || title.includes(q) || host.includes(q)) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // Admin Actions
    async function kickMember(partyCode, userId, memberName) {
      if (!confirm(`Are you sure you want to kick ${memberName} from Party ${partyCode}?`)) return;

      try {
        const res = await fetch(`/user/admin/access/api/room/${partyCode}/kick`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId })
        });
        const data = await res.json();
        if (data.success) {
          fetchStats();
        } else {
          alert(data.error || 'Failed to kick member');
        }
      } catch (err) {
        alert('Network error: ' + err.message);
      }
    }

    async function terminateParty(partyCode) {
      if (!confirm(`Are you sure you want to forcibly END party ${partyCode}? All members will be disconnected.`)) return;

      try {
        const res = await fetch(`/user/admin/access/api/room/${partyCode}/close`, {
          method: 'POST'
        });
        const data = await res.json();
        if (data.success) {
          fetchStats();
        } else {
          alert(data.error || 'Failed to close party');
        }
      } catch (err) {
        alert('Network error: ' + err.message);
      }
    }

    // Broadcast Modals
    function openBroadcastModal(target) {
      document.getElementById('broadcast-target').value = target;
      document.getElementById('broadcast-target-label').innerText = target === 'ALL' ? 'Global (All Parties)' : `Party: ${target}`;
      document.getElementById('broadcast-message-text').value = '';
      document.getElementById('broadcast-modal').style.display = 'flex';
      document.getElementById('broadcast-message-text').focus();
    }

    function closeBroadcastModal() {
      document.getElementById('broadcast-modal').style.display = 'none';
    }

    async function submitBroadcast() {
      const target = document.getElementById('broadcast-target').value;
      const text = document.getElementById('broadcast-message-text').value.trim();
      if (!text) {
        alert('Please enter a message.');
        return;
      }

      try {
        const res = await fetch('/user/admin/access/api/broadcast', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ partyCode: target === 'ALL' ? null : target, message: text })
        });
        const data = await res.json();
        if (data.success) {
          closeBroadcastModal();
          fetchStats();
        }
      } catch (err) {
        alert('Failed to send broadcast: ' + err.message);
      }
    }

    async function submitTabBroadcast() {
      const target = document.getElementById('tab-broadcast-target').value;
      const text = document.getElementById('tab-broadcast-text').value.trim();
      if (!text) {
        alert('Please enter an announcement message.');
        return;
      }

      try {
        const res = await fetch('/user/admin/access/api/broadcast', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ partyCode: target === 'ALL' ? null : target, message: text })
        });
        const data = await res.json();
        if (data.success) {
          alert('Announcement broadcasted successfully!');
          document.getElementById('tab-broadcast-text').value = '';
          fetchStats();
        }
      } catch (err) {
        alert('Failed to send broadcast: ' + err.message);
      }
    }
  </script>
</body>
</html>
