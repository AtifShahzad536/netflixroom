<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Netflix Room - Enterprise Admin Management Center</title>
  
  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Chart.js for High Performance Real-Time Graphs -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    /* ==========================================================================
       ENTERPRISE DESIGN SYSTEM & CSS VARIABLES
       ========================================================================== */
    :root {
      --bg-dark: #06070a;
      --bg-sidebar: #0a0c12;
      --bg-header: rgba(10, 12, 18, 0.92);
      --bg-card: #0f121a;
      --bg-card-hover: #151924;
      --bg-inner: #07090e;
      --border-subtle: #1c2233;
      --border-focus: #2d374d;
      --primary: #E50914;
      --primary-hover: #f40612;
      --primary-glow: rgba(229, 9, 20, 0.35);
      --accent-green: #10b981;
      --accent-cyan: #06b6d4;
      --accent-purple: #8b5cf6;
      --accent-amber: #f59e0b;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --text-dark: #64748b;
      --sidebar-width: 260px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
      border-radius: 5px !important;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      overflow-x: hidden;
    }

    /* Ambient Background Glow */
    .ambient-glow {
      position: fixed;
      top: 0;
      left: var(--sidebar-width);
      right: 0;
      height: 350px;
      background: radial-gradient(circle at 50% -20%, rgba(229, 9, 20, 0.12), transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    /* ==========================================================================
       SIDEBAR NAVIGATION
       ========================================================================== */
    aside.sidebar {
      width: var(--sidebar-width);
      background: var(--bg-sidebar);
      border-right: 1px solid var(--border-subtle);
      height: 100vh;
      position: fixed;
      top: 0;
      left: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      z-index: 100;
      transition: all 0.3s ease;
    }

    .sidebar-brand-box {
      padding: 22px 20px;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-badge {
      background: var(--primary);
      color: #fff;
      font-size: 0.7rem;
      font-weight: 900;
      padding: 3px 7px;
      text-transform: uppercase;
      letter-spacing: 0.8px;
    }

    .brand-title {
      font-size: 1.15rem;
      font-weight: 800;
      letter-spacing: -0.5px;
      color: #fff;
    }

    .brand-title span {
      color: var(--primary);
    }

    .sidebar-menu {
      padding: 16px 12px;
      display: flex;
      flex-direction: column;
      gap: 4px;
      flex: 1;
      overflow-y: auto;
    }

    .menu-heading {
      font-size: 0.68rem;
      font-weight: 800;
      text-transform: uppercase;
      color: var(--text-dark);
      letter-spacing: 1px;
      padding: 10px 10px 4px;
    }

    .nav-tab-btn {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 14px;
      color: var(--text-muted);
      background: transparent;
      border: 1px solid transparent;
      font-size: 0.86rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s ease;
      text-align: left;
    }

    .nav-tab-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .nav-tab-left i {
      width: 17px;
      height: 17px;
      color: var(--text-dark);
      transition: color 0.2s;
    }

    .nav-tab-btn:hover {
      background: #111520;
      color: #fff;
      border-color: rgba(255, 255, 255, 0.05);
    }

    .nav-tab-btn:hover i {
      color: #cbd5e1;
    }

    .nav-tab-btn.active {
      background: rgba(229, 9, 20, 0.12);
      color: #fff;
      border-color: rgba(229, 9, 20, 0.35);
      font-weight: 700;
    }

    .nav-tab-btn.active i {
      color: var(--primary);
    }

    .nav-badge-count {
      font-size: 0.68rem;
      font-weight: 800;
      padding: 2px 7px;
      background: rgba(255, 255, 255, 0.08);
      color: #cbd5e1;
      font-family: 'JetBrains Mono', monospace;
    }

    .nav-badge-count.active-pulse {
      background: rgba(16, 185, 129, 0.15);
      color: #34d399;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }

    /* Sidebar Footer Profile */
    .sidebar-footer {
      padding: 14px 16px;
      border-top: 1px solid var(--border-subtle);
      background: #08090e;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .admin-profile-box {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .admin-avatar {
      width: 34px;
      height: 34px;
      background: var(--primary);
      color: #fff;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
    }

    .admin-info h5 {
      font-size: 0.82rem;
      font-weight: 700;
      color: #fff;
    }

    .admin-info span {
      font-size: 0.68rem;
      color: var(--accent-green);
      font-weight: 600;
    }

    .btn-logout {
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #f87171;
      padding: 6px 10px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 4px;
      font-size: 0.75rem;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.2s;
    }

    .btn-logout:hover {
      background: #dc2626;
      color: #fff;
    }

    /* ==========================================================================
       MAIN VIEW WRAPPER & EXECUTIVE HEADER
       ========================================================================== */
    .app-wrapper {
      margin-left: var(--sidebar-width);
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      position: relative;
      z-index: 1;
    }

    header.app-header {
      background: var(--bg-header);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border-subtle);
      position: sticky;
      top: 0;
      z-index: 40;
      padding: 12px 28px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .header-left-tools {
      display: flex;
      align-items: center;
      gap: 16px;
      flex: 1;
      max-width: 500px;
    }

    .global-search-wrap {
      position: relative;
      width: 100%;
    }

    .global-search-wrap i {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      width: 15px;
      height: 15px;
      color: var(--text-dark);
    }

    .global-search-input {
      width: 100%;
      background: var(--bg-inner);
      border: 1px solid var(--border-subtle);
      padding: 8px 12px 8px 36px;
      color: #fff;
      font-size: 0.82rem;
      outline: none;
      transition: all 0.2s;
    }

    .global-search-input:focus {
      border-color: var(--primary);
    }

    .header-right-tools {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 10px;
      background: rgba(16, 185, 129, 0.08);
      border: 1px solid rgba(16, 185, 129, 0.25);
      color: #34d399;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .pulse-dot {
      width: 6px;
      height: 6px;
      background: #10b981;
      border-radius: 50% !important;
      box-shadow: 0 0 8px #10b981;
      animation: pulse 1.8s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(1.3); }
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 7px 14px;
      font-size: 0.82rem;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.2s ease;
      border: 1px solid transparent;
      outline: none;
    }

    .btn i {
      width: 15px;
      height: 15px;
    }

    .btn-primary {
      background: var(--primary);
      color: #fff;
      box-shadow: 0 2px 10px rgba(229, 9, 20, 0.35);
    }

    .btn-primary:hover {
      background: var(--primary-hover);
      box-shadow: 0 4px 16px rgba(229, 9, 20, 0.5);
    }

    .btn-secondary {
      background: #121622;
      color: #cbd5e1;
      border-color: var(--border-subtle);
    }

    .btn-secondary:hover {
      background: #1a2030;
      color: #fff;
      border-color: var(--border-focus);
    }

    .btn-danger {
      background: rgba(239, 68, 68, 0.15);
      color: #f87171;
      border-color: rgba(239, 68, 68, 0.35);
    }

    .btn-danger:hover {
      background: #dc2626;
      color: #fff;
    }

    /* ==========================================================================
       CONTENT VIEWS & TABS
       ========================================================================== */
    main.view-container {
      padding: 28px;
      flex: 1;
    }

    .tab-content-view {
      display: none;
    }

    .tab-content-view.active-view {
      display: block;
      animation: fadeIn 0.2s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .view-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      margin-bottom: 24px;
      flex-wrap: wrap;
      gap: 16px;
    }

    .view-title h2 {
      font-size: 1.6rem;
      font-weight: 800;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .view-title p {
      color: var(--text-muted);
      font-size: 0.85rem;
      margin-top: 4px;
    }

    /* KPI Grid */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }

    .kpi-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      padding: 18px 20px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      transition: all 0.2s ease;
      position: relative;
    }

    .kpi-card:hover {
      border-color: var(--border-focus);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0,0,0,0.4);
    }

    .kpi-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .kpi-label {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--text-muted);
    }

    .kpi-icon-wrap {
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: #fff;
    }

    .kpi-val {
      font-size: 2rem;
      font-weight: 900;
      color: #fff;
      line-height: 1;
      font-family: 'JetBrains Mono', monospace;
    }

    .kpi-footer {
      font-size: 0.72rem;
      color: var(--text-dark);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* Analytics Grid */
    .analytics-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 18px;
      margin-bottom: 24px;
    }

    @media (max-width: 1100px) {
      .analytics-grid {
        grid-template-columns: 1fr;
      }
    }

    .chart-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .chart-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .chart-head h3 {
      font-size: 0.98rem;
      font-weight: 800;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .chart-canvas-wrap {
      position: relative;
      height: 240px;
      width: 100%;
    }

    /* Section Cards & Tables */
    .section-box {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      padding: 22px;
      margin-bottom: 24px;
    }

    .section-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 18px;
      flex-wrap: wrap;
      gap: 12px;
    }

    .section-head h3 {
      font-size: 1.15rem;
      font-weight: 800;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .table-container {
      width: 100%;
      overflow-x: auto;
    }

    table.data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.82rem;
      text-align: left;
    }

    table.data-table th {
      background: var(--bg-inner);
      padding: 10px 14px;
      color: var(--text-muted);
      font-weight: 700;
      text-transform: uppercase;
      font-size: 0.7rem;
      letter-spacing: 0.6px;
      border-bottom: 1px solid var(--border-subtle);
    }

    table.data-table td {
      padding: 12px 14px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
      color: #cbd5e1;
      vertical-align: middle;
    }

    table.data-table tr:hover td {
      background: rgba(255, 255, 255, 0.02);
    }

    /* Badges */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 0.68rem;
      font-weight: 800;
      padding: 2px 7px;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }

    .badge-red {
      background: rgba(229, 9, 20, 0.15);
      color: #ff4d58;
      border: 1px solid rgba(229, 9, 20, 0.35);
    }

    .badge-green {
      background: rgba(16, 185, 129, 0.15);
      color: #34d399;
      border: 1px solid rgba(16, 185, 129, 0.35);
    }

    .badge-blue {
      background: rgba(56, 189, 248, 0.15);
      color: #38bdf8;
      border: 1px solid rgba(56, 189, 248, 0.35);
    }

    .badge-amber {
      background: rgba(245, 158, 11, 0.15);
      color: #fbbf24;
      border: 1px solid rgba(245, 158, 11, 0.35);
    }

    .badge-slate {
      background: rgba(100, 116, 139, 0.15);
      color: #94a3b8;
      border: 1px solid rgba(100, 116, 139, 0.3);
    }

    /* Rooms Grid */
    .rooms-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
      gap: 18px;
    }

    .room-card {
      background: #11141e;
      border: 1px solid var(--border-subtle);
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      transition: all 0.2s ease;
    }

    .room-card:hover {
      border-color: var(--border-focus);
      box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    }

    .room-card-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 10px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      padding-bottom: 12px;
    }

    .room-code-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.9rem;
      font-weight: 800;
      color: #ff4d58;
      background: rgba(229, 9, 20, 0.12);
      border: 1px solid rgba(229, 9, 20, 0.35);
      padding: 3px 8px;
    }

    .members-mini-list {
      display: flex;
      flex-direction: column;
      gap: 5px;
      max-height: 180px;
      overflow-y: auto;
    }

    .member-mini-item {
      background: var(--bg-inner);
      border: 1px solid var(--border-subtle);
      padding: 6px 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.78rem;
    }

    /* Modal */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.75);
      backdrop-filter: blur(8px);
      z-index: 200;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal-box {
      background: var(--bg-card);
      border: 1px solid var(--border-focus);
      width: 100%;
      max-width: 500px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      box-shadow: 0 20px 50px rgba(0,0,0,0.8);
    }

    .modal-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .modal-head h3 {
      font-size: 1.15rem;
      font-weight: 800;
      color: #fff;
    }

    .modal-body textarea, .modal-body input, .modal-body select {
      width: 100%;
      background: var(--bg-inner);
      border: 1px solid var(--border-subtle);
      padding: 10px 12px;
      color: #fff;
      font-size: 0.85rem;
      outline: none;
    }

    .modal-footer {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
    }
  </style>
</head>
<body>
  <div class="ambient-glow"></div>

  <!-- =========================================================================
       SIDEBAR
       ========================================================================= -->
  <aside class="sidebar">
    <div>
      <div class="sidebar-brand-box">
        <div class="brand-badge">PRO</div>
        <div class="brand-title">NETFLIX<span>ROOM</span></div>
      </div>

      <nav class="sidebar-menu">
        <span class="menu-heading">Main Navigation</span>
        
        <button class="nav-tab-btn active" onclick="switchNavTab('dashboard')">
          <span class="nav-tab-left">
            <i data-lucide="layout-dashboard"></i>
            <span>Dashboard Overview</span>
          </span>
        </button>

        <button class="nav-tab-btn" onclick="switchNavTab('parties')">
          <span class="nav-tab-left">
            <i data-lucide="tv"></i>
            <span>Active Parties</span>
          </span>
          <span class="nav-badge-count active-pulse" id="side-parties-count"><%= stats.totalParties %></span>
        </button>

        <button class="nav-tab-btn" onclick="switchNavTab('users')">
          <span class="nav-tab-left">
            <i data-lucide="users"></i>
            <span>All Connected Users</span>
          </span>
          <span class="nav-badge-count" id="side-members-count"><%= stats.totalMembers %></span>
        </button>

        <button class="nav-tab-btn" onclick="switchNavTab('voice')">
          <span class="nav-tab-left">
            <i data-lucide="mic"></i>
            <span>WebRTC Voice Hub</span>
          </span>
          <span class="nav-badge-count" id="side-voice-count"><%= stats.totalVoiceUsers %></span>
        </button>

        <span class="menu-heading">Operations & Logs</span>

        <button class="nav-tab-btn" onclick="switchNavTab('chat')">
          <span class="nav-tab-left">
            <i data-lucide="message-square"></i>
            <span>Live Chat Stream</span>
          </span>
          <span class="nav-badge-count" id="side-messages-count"><%= stats.totalMessages %></span>
        </button>

        <button class="nav-tab-btn" onclick="switchNavTab('broadcast')">
          <span class="nav-tab-left">
            <i data-lucide="radio"></i>
            <span>Broadcast Center</span>
          </span>
        </button>

        <button class="nav-tab-btn" onclick="switchNavTab('audit')">
          <span class="nav-tab-left">
            <i data-lucide="shield-alert"></i>
            <span>Security Audit Logs</span>
          </span>
        </button>

        <button class="nav-tab-btn" onclick="switchNavTab('settings')">
          <span class="nav-tab-left">
            <i data-lucide="sliders"></i>
            <span>Server & Engine Config</span>
          </span>
        </button>
      </nav>
    </div>

    <!-- Admin User Info & Logout -->
    <div class="sidebar-footer">
      <div class="admin-profile-box">
        <div class="admin-avatar">
          <%= (user && user.username ? user.username.charAt(0).toUpperCase() : 'A') %>
        </div>
        <div class="admin-info">
          <h5><%= (user && user.username ? user.username : 'Administrator') %></h5>
          <span>Super Admin</span>
        </div>
      </div>
      <a href="/user/admin/logout" class="btn-logout" title="Log out from Admin Center">
        <i data-lucide="log-out" style="width: 14px; height: 14px;"></i>
        <span>Logout</span>
      </a>
    </div>
  </aside>

  <!-- =========================================================================
       EXECUTIVE HEADER & MAIN VIEWS
       ========================================================================= -->
  <div class="app-wrapper">
    <!-- Executive Header -->
    <header class="app-header">
      <div class="header-left-tools">
        <div class="global-search-wrap">
          <i data-lucide="search"></i>
          <input 
            type="text" 
            placeholder="Global search rooms, members, titles, or socket IDs..." 
            class="global-search-input"
            id="global-search"
            oninput="handleGlobalSearch()"
          >
        </div>
      </div>

      <div class="header-right-tools">
        <span class="status-pill">
          <span class="pulse-dot"></span> Cluster Node 1 Active
        </span>

        <span style="font-size: 0.78rem; color: var(--text-dark); font-family: 'JetBrains Mono', monospace;" id="clock-display">
          --:--:--
        </span>

        <button class="btn btn-secondary" onclick="triggerManualRefresh()" id="refresh-btn">
          <i data-lucide="refresh-cw"></i> Refresh
        </button>

        <button class="btn btn-primary" onclick="openBroadcastModal('ALL')">
          <i data-lucide="send"></i> Global Broadcast
        </button>
      </div>
    </header>

    <!-- Main Content Tabs -->
    <main class="view-container">

      <!-- =====================================================================
           TAB 1: DASHBOARD OVERVIEW
