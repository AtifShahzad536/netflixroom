<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Netflix Room - Real-Time Server Admin & Control Center</title>
  
  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Chart.js for High Performance Real-Time Graphs -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    /* ==========================================================================
       GLOBAL STYLES & CSS VARIABLES
       ========================================================================== */
    :root {
      --bg-dark: #07080c;
      --bg-card: #0e1118;
      --bg-card-hover: #141824;
      --bg-inner: #080a0f;
      --border-subtle: #1c2233;
      --border-focus: #2d374d;
      --primary: #E50914;
      --primary-hover: #f40612;
      --primary-glow: rgba(229, 9, 20, 0.35);
      --accent-green: #10b981;
      --accent-cyan: #06b6d4;
      --accent-purple: #8b5cf6;
      --accent-amber: #f59e0b;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --text-dark: #64748b;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
      border-radius: 5px !important;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    /* Ambient Background Effects */
    .ambient-glow {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 400px;
      background: radial-gradient(circle at 50% -20%, rgba(229, 9, 20, 0.15), transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    .grid-overlay {
      position: fixed;
      inset: 0;
      background-image: 
        linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
      z-index: 0;
    }

    .container {
      max-width: 1440px;
      margin: 0 auto;
      padding: 0 24px;
      width: 100%;
      position: relative;
      z-index: 1;
    }

    /* ==========================================================================
       HEADER & NAVIGATION
       ========================================================================== */
    header {
      background: rgba(10, 12, 18, 0.85);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border-subtle);
      position: sticky;
      top: 0;
      z-index: 50;
      padding: 14px 0;
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand-wrap {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: #fff;
    }

    .brand-badge {
      background: var(--primary);
      color: #fff;
      font-size: 0.72rem;
      font-weight: 900;
      padding: 3px 8px;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .brand-title {
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: -0.5px;
    }

    .brand-title span {
      color: var(--primary);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      background: rgba(16, 185, 129, 0.08);
      border: 1px solid rgba(16, 185, 129, 0.25);
      color: #34d399;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .pulse-dot {
      width: 7px;
      height: 7px;
      background: #10b981;
      border-radius: 50% !important;
      box-shadow: 0 0 10px #10b981;
      animation: pulse 1.8s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(1.3); }
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 8px 16px;
      font-size: 0.85rem;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.2s ease;
      border: 1px solid transparent;
      outline: none;
    }

    .btn i {
      width: 16px;
      height: 16px;
    }

    .btn-primary {
      background: var(--primary);
      color: #fff;
      box-shadow: 0 2px 10px rgba(229, 9, 20, 0.35);
    }

    .btn-primary:hover {
      background: var(--primary-hover);
      box-shadow: 0 4px 16px rgba(229, 9, 20, 0.5);
    }

    .btn-secondary {
      background: #151924;
      color: #cbd5e1;
      border-color: var(--border-subtle);
    }

    .btn-secondary:hover {
      background: #1d2333;
      color: #fff;
      border-color: var(--border-focus);
    }

    .btn-danger {
      background: rgba(239, 68, 68, 0.15);
      color: #f87171;
      border-color: rgba(239, 68, 68, 0.35);
    }

    .btn-danger:hover {
      background: #dc2626;
      color: #fff;
    }

    /* ==========================================================================
       DASHBOARD CONTENT
       ========================================================================== */
    main {
      padding: 30px 0 60px;
      flex: 1;
    }

    .page-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      margin-bottom: 28px;
      flex-wrap: wrap;
      gap: 16px;
    }

    .page-title h1 {
      font-size: 1.8rem;
      font-weight: 800;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .page-title p {
      color: var(--text-muted);
      font-size: 0.9rem;
      margin-top: 4px;
    }

    /* Top KPI Metric Cards */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 16px;
      margin-bottom: 28px;
    }

    .kpi-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      transition: all 0.2s ease;
      position: relative;
      overflow: hidden;
    }

    .kpi-card:hover {
      border-color: var(--border-focus);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0,0,0,0.4);
    }

    .kpi-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .kpi-label {
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--text-muted);
    }

    .kpi-icon-wrap {
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: #fff;
    }

    .kpi-val {
      font-size: 2.2rem;
      font-weight: 900;
      color: #fff;
      line-height: 1;
      font-family: 'JetBrains Mono', monospace;
    }

    .kpi-footer {
      font-size: 0.75rem;
      color: var(--text-dark);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* ==========================================================================
       GRAPHS & ANALYTICS SECTION
       ========================================================================== */
    .analytics-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 20px;
      margin-bottom: 32px;
    }

    @media (max-width: 1024px) {
      .analytics-grid {
        grid-template-columns: 1fr;
      }
    }

    .chart-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      padding: 22px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .chart-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .chart-head h3 {
      font-size: 1.05rem;
      font-weight: 800;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .chart-canvas-wrap {
      position: relative;
      height: 250px;
      width: 100%;
    }

    /* ==========================================================================
       ACTIVE PARTIES & ROOMS SECTION
       ========================================================================== */
    .section-box {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      padding: 24px;
      margin-bottom: 32px;
    }

    .section-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
      flex-wrap: wrap;
      gap: 12px;
    }

    .section-head h2 {
      font-size: 1.3rem;
      font-weight: 800;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .search-input {
      background: var(--bg-inner);
      border: 1px solid var(--border-subtle);
      padding: 8px 14px;
      color: #fff;
      font-size: 0.85rem;
      width: 260px;
      outline: none;
    }

    .search-input:focus {
      border-color: var(--primary);
    }

    /* Rooms Grid / Cards */
    .rooms-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
      gap: 20px;
    }

    @media (max-width: 600px) {
      .rooms-grid {
        grid-template-columns: 1fr;
      }
    }

    .room-card {
      background: #11141e;
      border: 1px solid var(--border-subtle);
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      transition: all 0.25s ease;
      position: relative;
    }

    .room-card:hover {
      border-color: var(--border-focus);
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    .room-card-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      padding-bottom: 14px;
    }

    .room-code-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.95rem;
      font-weight: 800;
      color: #ff4d58;
      background: rgba(229, 9, 20, 0.12);
      border: 1px solid rgba(229, 9, 20, 0.35);
      padding: 4px 10px;
      letter-spacing: 0.5px;
    }

    .room-name-wrap h4 {
      font-size: 1.1rem;
      font-weight: 800;
      color: #fff;
      margin-bottom: 4px;
    }

    .room-meta-info {
      font-size: 0.78rem;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    /* Media Stream HUD */
    .media-hud {
      background: var(--bg-inner);
      border: 1px solid var(--border-subtle);
      padding: 12px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .media-title-text {
      font-size: 0.85rem;
      font-weight: 700;
      color: #f8fafc;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .playback-status-pill {
      font-size: 0.7rem;
      font-weight: 800;
      text-transform: uppercase;
      padding: 3px 8px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .status-playing {
      background: rgba(16, 185, 129, 0.12);
      color: #34d399;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .status-paused {
      background: rgba(245, 158, 11, 0.12);
      color: #fbbf24;
      border: 1px solid rgba(245, 158, 11, 0.3);
    }

    /* Members Roster ("Kon Kon Join Hua Hai") */
    .members-section-title {
      font-size: 0.8rem;
      font-weight: 800;
      text-transform: uppercase;
      color: var(--text-muted);
      letter-spacing: 0.8px;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .members-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
      max-height: 220px;
      overflow-y: auto;
      padding-right: 4px;
    }

    .member-item {
      background: var(--bg-inner);
      border: 1px solid var(--border-subtle);
      padding: 8px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      font-size: 0.82rem;
    }

    .member-info-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .member-avatar {
      width: 28px;
      height: 28px;
      background: #252b3d;
      color: #fff;
      font-weight: 800;
      font-size: 0.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .member-avatar.host {
      background: var(--primary);
    }

    .member-tags {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .tag-pill {
      font-size: 0.65rem;
      font-weight: 700;
      padding: 1px 6px;
      text-transform: uppercase;
    }

    .tag-host {
      background: rgba(229, 9, 20, 0.15);
      color: #ff4d58;
      border: 1px solid rgba(229, 9, 20, 0.35);
    }

    .tag-voice {
      background: rgba(16, 185, 129, 0.15);
      color: #34d399;
      border: 1px solid rgba(16, 185, 129, 0.35);
    }

    .tag-muted {
      background: rgba(100, 116, 139, 0.15);
      color: #94a3b8;
      border: 1px solid rgba(100, 116, 139, 0.3);
    }

    .member-actions-wrap {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .room-card-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding-top: 14px;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    /* Empty state */
    .empty-state-box {
      text-align: center;
      padding: 60px 20px;
      color: var(--text-muted);
      border: 1px dashed var(--border-subtle);
    }

    .empty-state-box i {
      width: 48px;
      height: 48px;
      color: var(--text-dark);
      margin-bottom: 12px;
    }

    /* Live Events Feed */
    .events-feed-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      max-height: 280px;
      overflow-y: auto;
    }

    .event-log-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 12px;
      background: var(--bg-inner);
      border: 1px solid var(--border-subtle);
      font-size: 0.8rem;
    }

    .event-log-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .event-badge {
      padding: 2px 6px;
      font-size: 0.65rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .event-time {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      color: var(--text-dark);
    }

    /* Footer */
    footer {
      border-top: 1px solid var(--border-subtle);
      background: var(--bg-inner);
      padding: 24px 0;
      font-size: 0.8rem;
      color: var(--text-dark);
      text-align: center;
    }

    /* Modal */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.75);
      backdrop-filter: blur(8px);
      z-index: 100;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal-box {
      background: var(--bg-card);
      border: 1px solid var(--border-focus);
      width: 100%;
      max-width: 480px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      box-shadow: 0 20px 50px rgba(0,0,0,0.8);
    }

    .modal-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .modal-head h3 {
      font-size: 1.15rem;
      font-weight: 800;
      color: #fff;
    }

    .modal-body textarea, .modal-body input {
      width: 100%;
      background: var(--bg-inner);
      border: 1px solid var(--border-subtle);
      padding: 10px 12px;
      color: #fff;
      font-size: 0.85rem;
      outline: none;
    }

    .modal-footer {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
    }
  </style>
</head>
<body>
  <div class="ambient-glow"></div>
  <div class="grid-overlay"></div>

  <!-- Header -->
  <header>
    <div class="container header-inner">
      <div style="display: flex; align-items: center; gap: 16px;">
        <a href="/" class="brand-wrap">
          <div class="brand-badge">PRO</div>
          <div class="brand-title">NETFLIX<span>ROOM</span> ADMIN</div>
        </a>
        <span class="status-pill">
          <span class="pulse-dot"></span> Live Server Node
        </span>
      </div>

      <div class="header-actions">
        <button class="btn btn-secondary" onclick="triggerManualRefresh()" id="refresh-btn">
          <i data-lucide="refresh-cw"></i> Refresh
        </button>
        <button class="btn btn-primary" onclick="openBroadcastModal('ALL')">
          <i data-lucide="radio"></i> Global Broadcast
        </button>
      </div>
    </div>
  </header>

  <!-- Main Content Area -->
  <main>
    <div class="container">
      
      <!-- Page Header -->
      <div class="page-head">
        <div class="page-title">
          <h1>
            <i data-lucide="shield" style="color: var(--primary); width: 28px; height: 28px;"></i>
            Real-Time Party Monitor & Diagnostics
          </h1>
          <p>Live tracking of active watch parties, connected users, WebRTC voice mesh streams, and playback synchronization.</p>
        </div>

        <div style="display: flex; align-items: center; gap: 12px;">
          <span style="font-size: 0.8rem; color: var(--text-muted);">
            Auto-Refresh: <strong style="color: #34d399;" id="auto-refresh-state">ON (3s)</strong>
          </span>
          <span style="font-size: 0.8rem; color: var(--text-dark);">|</span>
          <span style="font-size: 0.8rem; color: var(--text-muted); font-family: 'JetBrains Mono', monospace;" id="clock-display">--:--:--</span>
        </div>
      </div>

      <!-- KPI Metrics Grid -->
      <div class="kpi-grid">
        <!-- 1. Active Parties -->
        <div class="kpi-card">
          <div class="kpi-top">
            <span class="kpi-label">Active Parties</span>
            <div class="kpi-icon-wrap" style="color: #E50914;"><i data-lucide="tv"></i></div>
          </div>
          <div class="kpi-val" id="kpi-parties"><%= stats.totalParties %></div>
          <div class="kpi-footer">
            <i data-lucide="activity" style="width: 12px; height: 12px; color: #10b981;"></i> Currently streaming
          </div>
        </div>

        <!-- 2. Total Connected Members -->
        <div class="kpi-card">
          <div class="kpi-top">
            <span class="kpi-label">Connected Members</span>
            <div class="kpi-icon-wrap" style="color: #38bdf8;"><i data-lucide="users"></i></div>
          </div>
          <div class="kpi-val" id="kpi-members"><%= stats.totalMembers %></div>
          <div class="kpi-footer">
            <i data-lucide="user-check" style="width: 12px; height: 12px; color: #38bdf8;"></i> Across all rooms
          </div>
        </div>

        <!-- 3. WebRTC Voice Users -->
        <div class="kpi-card">
          <div class="kpi-top">
            <span class="kpi-label">Active Voice Mesh</span>
            <div class="kpi-icon-wrap" style="color: #10b981;"><i data-lucide="mic"></i></div>
          </div>
          <div class="kpi-val" id="kpi-voice"><%= stats.totalVoiceUsers %></div>
          <div class="kpi-footer">
            <i data-lucide="volume-2" style="width: 12px; height: 12px; color: #10b981;"></i> Spatial audio streams
          </div>
        </div>

        <!-- 4. Messages Sent -->
        <div class="kpi-card">
          <div class="kpi-top">
            <span class="kpi-label">Chat & Stickers</span>
            <div class="kpi-icon-wrap" style="color: #f59e0b;"><i data-lucide="message-square"></i></div>
          </div>
          <div class="kpi-val" id="kpi-messages"><%= stats.totalMessages %></div>
          <div class="kpi-footer">
            <i data-lucide="sparkles" style="width: 12px; height: 12px; color: #f59e0b;"></i> Real-time messages
          </div>
        </div>

        <!-- 5. Playing vs Paused -->
        <div class="kpi-card">
          <div class="kpi-top">
            <span class="kpi-label">Sync Play State</span>
            <div class="kpi-icon-wrap" style="color: #a855f7;"><i data-lucide="play-circle"></i></div>
          </div>
          <div class="kpi-val" id="kpi-playing" style="font-size: 1.8rem;">
            <%= stats.playingCount %> <span style="font-size: 1rem; color: var(--text-dark);">/ <%= stats.pausedCount %> paused</span>
          </div>
          <div class="kpi-footer">
            <i data-lucide="zap" style="width: 12px; height: 12px; color: #a855f7;"></i> Frame-accurate lock
          </div>
        </div>

        <!-- 6. Memory & Node Health -->
        <div class="kpi-card">
          <div class="kpi-top">
            <span class="kpi-label">RAM / Heap</span>
            <div class="kpi-icon-wrap" style="color: #ec4899;"><i data-lucide="cpu"></i></div>
          </div>
          <div class="kpi-val" id="kpi-memory" style="font-size: 1.8rem;"><%= stats.memoryMb %> MB</div>
          <div class="kpi-footer">
            <i data-lucide="server" style="width: 12px; height: 12px; color: #ec4899;"></i> Node.js V8 Engine
          </div>
        </div>
      </div>

      <!-- Live Analytics & Graphs -->
      <div class="analytics-grid">
        <!-- Main Line Chart: Real-time Concurrency -->
        <div class="chart-card">
          <div class="chart-head">
            <h3><i data-lucide="trending-up" style="color: #E50914;"></i> Real-Time Active Users & Voice Streams Over Time</h3>
            <span style="font-size: 0.75rem; color: var(--text-dark);">Updated every 3s</span>
          </div>
          <div class="chart-canvas-wrap">
            <canvas id="trafficChart"></canvas>
          </div>
        </div>

        <!-- Doughnut Chart: Netflix Titles / Media breakdown -->
        <div class="chart-card">
          <div class="chart-head">
            <h3><i data-lucide="pie-chart" style="color: #38bdf8;"></i> Stream Titles Breakdown</h3>
            <span style="font-size: 0.75rem; color: var(--text-dark);">Active Content</span>
          </div>
          <div class="chart-canvas-wrap">
            <canvas id="titlesChart"></canvas>
          </div>
        </div>
      </div>

      <!-- Active Watch Parties List Section ("Kon Kon Join Hua Hai") -->
      <div class="section-box">
        <div class="section-head">
          <h2>
            <i data-lucide="layers" style="color: var(--primary);"></i>
            Live Active Watch Parties (<span id="rooms-count-header"><%= stats.totalParties %></span>)
          </h2>
          <input 
            type="text" 
            placeholder="Search by Room Code, Host or Title..." 
            class="search-input"
            id="search-input"
            oninput="filterRooms()"
          >
        </div>

        <!-- Rooms Container -->
        <div class="rooms-grid" id="rooms-container">
          <% if (stats.rooms && stats.rooms.length > 0) { %>
            <% stats.rooms.forEach(function(room) { %>
              <div class="room-card" data-code="<%= room.partyCode %>" data-title="<%= room.mediaInfo.title %>" data-host="<%= room.hostName %>">
                <div class="room-card-head">
                  <div class="room-name-wrap">
                    <h4><%= room.name %></h4>
                    <div class="room-meta-info">
                      <span><strong>Host:</strong> <%= room.hostName %></span>
                      <span>•</span>
                      <span><strong>Members:</strong> <%= room.memberCount %></span>
                      <span>•</span>
                      <span><strong>Voice:</strong> <%= room.voiceCount %> active</span>
                    </div>
                  </div>
                  <span class="room-code-badge"><%= room.partyCode %></span>
                </div>

                <!-- Media Stream HUD -->
                <div class="media-hud">
                  <div class="media-title-text">
                    <i data-lucide="film" style="color: #E50914; width: 16px; height: 16px;"></i>
                    <span><%= room.mediaInfo.title || 'Netflix Stream' %></span>
                  </div>
                  <% if (room.playbackState.isPlaying) { %>
                    <span class="playback-status-pill status-playing">
                      <i data-lucide="play" style="width: 10px; height: 10px;"></i> Playing (<%= Math.floor(room.playbackState.currentTime) %>s)
                    </span>
                  <% } else { %>
                    <span class="playback-status-pill status-paused">
                      <i data-lucide="pause" style="width: 10px; height: 10px;"></i> Paused (<%= Math.floor(room.playbackState.currentTime) %>s)
                    </span>
                  <% } %>
                </div>

                <!-- Members Roster ("Kon Kon Join Hua Hai") -->
                <div>
                  <div class="members-section-title">
                    <span>Joined Members (<%= room.memberCount %>)</span>
                    <span style="font-size: 0.7rem; color: #10b981;">● Online</span>
                  </div>

                  <div class="members-list">
                    <% room.members.forEach(function(member) { %>
                      <div class="member-item">
                        <div class="member-info-left">
                          <div class="member-avatar <%= member.isHost ? 'host' : '' %>">
                            <%= member.name ? member.name.charAt(0).toUpperCase() : 'U' %>
                          </div>
                          <div>
                            <div style="font-weight: 700; color: #fff; font-size: 0.82rem;">
                              <%= member.name %>
                            </div>
                            <div style="font-size: 0.68rem; color: var(--text-dark); font-family: monospace;">
                              ID: <%= member.userId %>
                            </div>
                          </div>
                        </div>

                        <div class="member-actions-wrap">
                          <div class="member-tags">
                            <% if (member.isHost) { %>
                              <span class="tag-pill tag-host">👑 Host</span>
                            <% } %>
                            <% if (member.inVoice) { %>
                              <span class="tag-pill tag-voice">🎙️ Voice</span>
                            <% } %>
                            <% if (member.isMuted) { %>
                              <span class="tag-pill tag-muted">🔇 Muted</span>
                            <% } %>
                          </div>

                          <% if (!member.isHost) { %>
                            <button 
                              class="btn btn-danger" 
                              style="padding: 2px 8px; font-size: 0.7rem;"
                              onclick="kickMember('<%= room.partyCode %>', '<%= member.userId %>', '<%= member.name %>')"
                              title="Kick member from party"
                            >
                              Kick
                            </button>
                          <% } %>
                        </div>
                      </div>
                    <% }); %>
                  </div>
                </div>

                <!-- Room Actions -->
                <div class="room-card-actions">
                  <button class="btn btn-secondary" style="font-size: 0.75rem; padding: 6px 12px;" onclick="openBroadcastModal('<%= room.partyCode %>')">
                    <i data-lucide="message-circle"></i> Send Notice
                  </button>

                  <button class="btn btn-danger" style="font-size: 0.75rem; padding: 6px 12px;" onclick="terminateParty('<%= room.partyCode %>')">
                    <i data-lucide="x-circle"></i> End Party
                  </button>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div class="empty-state-box" id="empty-state" style="grid-column: 1 / -1;">
              <i data-lucide="tv-2"></i>
              <h3>No Active Watch Parties Right Now</h3>
              <p style="margin-top: 6px; font-size: 0.85rem;">When users open the extension on Netflix and create a room, it will appear here in real-time with full member and stream diagnostics.</p>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Recent System Events Audit Log -->
      <div class="section-box">
        <div class="section-head">
          <h2>
            <i data-lucide="activity" style="color: #38bdf8;"></i>
            Real-Time Audit Event Stream
          </h2>
          <span style="font-size: 0.8rem; color: var(--text-dark);">Live socket actions & administrative triggers</span>
        </div>

        <div class="events-feed-list" id="events-feed-container">
          <% if (stats.recentEvents && stats.recentEvents.length > 0) { %>
            <% stats.recentEvents.forEach(function(evt) { %>
              <div class="event-log-item">
                <div class="event-log-left">
                  <span class="event-badge" style="background: rgba(229, 9, 20, 0.15); color: #ff4d58;">
                    <%= evt.type %>
                  </span>
                  <span style="color: #cbd5e1; font-weight: 600;"><%= evt.title %></span>
                </div>
                <span class="event-time"><%= new Date(evt.timestamp).toLocaleTimeString() %></span>
              </div>
            <% }); %>
          <% } else { %>
            <div style="padding: 20px; text-align: center; color: var(--text-dark); font-size: 0.85rem;">
              No admin events recorded yet.
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </main>

  <!-- Broadcast Notice Modal -->
  <div class="modal-backdrop" id="broadcast-modal">
    <div class="modal-box">
      <div class="modal-head">
        <h3><i data-lucide="send" style="color: var(--primary);"></i> Send Admin Announcement</h3>
        <button onclick="closeBroadcastModal()" style="background: none; border: none; color: #94a3b8; cursor: pointer;">
          <i data-lucide="x"></i>
        </button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="broadcast-target" value="ALL">
        <p style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 8px;">
          Target: <strong id="broadcast-target-label" style="color: #fff;">Global (All Parties)</strong>
        </p>
        <textarea id="broadcast-message-text" rows="4" placeholder="Enter message to broadcast to chat in real-time..."></textarea>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="closeBroadcastModal()">Cancel</button>
        <button class="btn btn-primary" onclick="submitBroadcast()"><i data-lucide="send"></i> Send Broadcast</button>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer>
    <div class="container">
      <p>Netflix Room Real-Time Cluster Management • EJS Admin Console • Version 2.4.0</p>
      <p style="margin-top: 4px; color: var(--text-dark); font-size: 0.72rem;">Route: /user/admin/access</p>
    </div>
  </footer>

  <!-- Real-time Dashboard Logic & Chart.js -->
  <script>
    if (window.lucide) {
      lucide.createIcons();
    }

    // Live Clock
    function updateClock() {
      const now = new Date();
      document.getElementById('clock-display').innerText = now.toLocaleTimeString();
    }
    setInterval(updateClock, 1000);
    updateClock();

    // =========================================================================
    // CHART.JS INITIALIZATION
    // =========================================================================
    const trafficCtx = document.getElementById('trafficChart').getContext('2d');
    const titlesCtx = document.getElementById('titlesChart').getContext('2d');

    const maxHistoryPoints = 15;
    const timeLabels = [];
    const membersData = [];
    const voiceData = [];

    // Initialize with recent timestamps
    for (let i = maxHistoryPoints - 1; i >= 0; i--) {
      const t = new Date(Date.now() - i * 3000);
      timeLabels.push(t.toLocaleTimeString());
      membersData.push(<%= stats.totalMembers %>);
      voiceData.push(<%= stats.totalVoiceUsers %>);
    }

    const trafficChart = new Chart(trafficCtx, {
      type: 'line',
      data: {
        labels: timeLabels,
        datasets: [
          {
            label: 'Connected Members',
            data: membersData,
            borderColor: '#38bdf8',
            backgroundColor: 'rgba(56, 189, 248, 0.1)',
            borderWidth: 2,
            tension: 0.35,
            fill: true,
            pointRadius: 3
          },
          {
            label: 'WebRTC Voice Streams',
            data: voiceData,
            borderColor: '#10b981',
            backgroundColor: 'rgba(16, 185, 129, 0.08)',
            borderWidth: 2,
            tension: 0.35,
            fill: true,
            pointRadius: 3
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            labels: { color: '#cbd5e1', font: { family: 'Outfit', size: 11 } }
          }
        },
        scales: {
          x: {
            grid: { color: 'rgba(255, 255, 255, 0.04)' },
            ticks: { color: '#64748b', font: { size: 10 } }
          },
          y: {
            beginAtZero: true,
            grid: { color: 'rgba(255, 255, 255, 0.04)' },
            ticks: { color: '#64748b', precision: 0 }
          }
        }
      }
    });

    // Titles Breakdown Doughnut Chart
    const titleLabels = Object.keys(<%- JSON.stringify(stats.titleBreakdown || {}) %>);
    const titleCounts = Object.values(<%- JSON.stringify(stats.titleBreakdown || {}) %>);

    const titlesChart = new Chart(titlesCtx, {
      type: 'doughnut',
      data: {
        labels: titleLabels.length ? titleLabels : ['No Active Stream'],
        datasets: [{
          data: titleCounts.length ? titleCounts : [1],
          backgroundColor: [
            '#E50914',
            '#38bdf8',
            '#10b981',
            '#f59e0b',
            '#8b5cf6',
            '#ec4899'
          ],
          borderColor: '#0e1118',
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom',
            labels: { color: '#cbd5e1', font: { family: 'Outfit', size: 10 }, boxWidth: 12 }
          }
        }
      }
    });

    // =========================================================================
    // REAL-TIME AUTO-REFRESH & DATA FETCHING
    // =========================================================================
    async function fetchStats() {
      try {
        const res = await fetch('/user/admin/access/api/stats');
        if (!res.ok) return;
        const data = await res.json();
        renderDashboard(data);
      } catch (err) {
        console.error('Failed to poll admin stats:', err);
      }
    }

    function renderDashboard(data) {
      // Update KPIs
      document.getElementById('kpi-parties').innerText = data.totalParties;
      document.getElementById('kpi-members').innerText = data.totalMembers;
      document.getElementById('kpi-voice').innerText = data.totalVoiceUsers;
      document.getElementById('kpi-messages').innerText = data.totalMessages;
      document.getElementById('kpi-playing').innerHTML = `${data.playingCount} <span style="font-size: 1rem; color: var(--text-dark);">/ ${data.pausedCount} paused</span>`;
      document.getElementById('kpi-memory').innerText = `${data.memoryMb} MB`;
      document.getElementById('rooms-count-header').innerText = data.totalParties;

      // Update Chart
      const nowStr = new Date().toLocaleTimeString();
      trafficChart.data.labels.push(nowStr);
      trafficChart.data.datasets[0].data.push(data.totalMembers);
      trafficChart.data.datasets[1].data.push(data.totalVoiceUsers);

      if (trafficChart.data.labels.length > maxHistoryPoints) {
        trafficChart.data.labels.shift();
        trafficChart.data.datasets[0].data.shift();
        trafficChart.data.datasets[1].data.shift();
      }
      trafficChart.update('none');

      // Update Titles Chart
      const tLabels = Object.keys(data.titleBreakdown || {});
      const tCounts = Object.values(data.titleBreakdown || {});
      titlesChart.data.labels = tLabels.length ? tLabels : ['No Active Stream'];
      titlesChart.data.datasets[0].data = tCounts.length ? tCounts : [1];
      titlesChart.update('none');

      // Update Rooms Grid
      renderRooms(data.rooms || []);

      // Update Events
      renderEvents(data.recentEvents || []);
    }

    function renderRooms(rooms) {
      const container = document.getElementById('rooms-container');
      if (!rooms || rooms.length === 0) {
        container.innerHTML = `
          <div class="empty-state-box" id="empty-state" style="grid-column: 1 / -1;">
            <i data-lucide="tv-2"></i>
            <h3>No Active Watch Parties Right Now</h3>
            <p style="margin-top: 6px; font-size: 0.85rem;">When users open the extension on Netflix and create a room, it will appear here in real-time with full member and stream diagnostics.</p>
          </div>
        `;
        if (window.lucide) lucide.createIcons();
        return;
      }

      let html = '';
      rooms.forEach(room => {
        const isPlaying = room.playbackState && room.playbackState.isPlaying;
        const curTime = room.playbackState ? Math.floor(room.playbackState.currentTime) : 0;
        
        let membersHtml = '';
        (room.members || []).forEach(m => {
          membersHtml += `
            <div class="member-item">
              <div class="member-info-left">
                <div class="member-avatar ${m.isHost ? 'host' : ''}">
                  ${(m.name || 'U').charAt(0).toUpperCase()}
                </div>
                <div>
                  <div style="font-weight: 700; color: #fff; font-size: 0.82rem;">${m.name}</div>
                  <div style="font-size: 0.68rem; color: var(--text-dark); font-family: monospace;">ID: ${m.userId}</div>
                </div>
              </div>
              <div class="member-actions-wrap">
                <div class="member-tags">
                  ${m.isHost ? '<span class="tag-pill tag-host">👑 Host</span>' : ''}
                  ${m.inVoice ? '<span class="tag-pill tag-voice">🎙️ Voice</span>' : ''}
                  ${m.isMuted ? '<span class="tag-pill tag-muted">🔇 Muted</span>' : ''}
                </div>
                ${!m.isHost ? `
                  <button class="btn btn-danger" style="padding: 2px 8px; font-size: 0.7rem;" onclick="kickMember('${room.partyCode}', '${m.userId}', '${m.name}')" title="Kick member">Kick</button>
                ` : ''}
              </div>
            </div>
          `;
        });

        html += `
          <div class="room-card" data-code="${room.partyCode}" data-title="${room.mediaInfo?.title || ''}" data-host="${room.hostName}">
            <div class="room-card-head">
              <div class="room-name-wrap">
                <h4>${room.name}</h4>
                <div class="room-meta-info">
                  <span><strong>Host:</strong> ${room.hostName}</span>
                  <span>•</span>
                  <span><strong>Members:</strong> ${room.memberCount}</span>
                  <span>•</span>
                  <span><strong>Voice:</strong> ${room.voiceCount} active</span>
                </div>
              </div>
              <span class="room-code-badge">${room.partyCode}</span>
            </div>

            <div class="media-hud">
              <div class="media-title-text">
                <i data-lucide="film" style="color: #E50914; width: 16px; height: 16px;"></i>
                <span>${room.mediaInfo?.title || 'Netflix Stream'}</span>
              </div>
              <span class="playback-status-pill ${isPlaying ? 'status-playing' : 'status-paused'}">
                <i data-lucide="${isPlaying ? 'play' : 'pause'}" style="width: 10px; height: 10px;"></i>
                ${isPlaying ? 'Playing' : 'Paused'} (${curTime}s)
              </span>
            </div>

            <div>
              <div class="members-section-title">
                <span>Joined Members (${room.memberCount})</span>
                <span style="font-size: 0.7rem; color: #10b981;">● Online</span>
              </div>
              <div class="members-list">
                ${membersHtml}
              </div>
            </div>

            <div class="room-card-actions">
              <button class="btn btn-secondary" style="font-size: 0.75rem; padding: 6px 12px;" onclick="openBroadcastModal('${room.partyCode}')">
                <i data-lucide="message-circle"></i> Send Notice
              </button>
              <button class="btn btn-danger" style="font-size: 0.75rem; padding: 6px 12px;" onclick="terminateParty('${room.partyCode}')">
                <i data-lucide="x-circle"></i> End Party
              </button>
            </div>
          </div>
        `;
      });

      container.innerHTML = html;
      if (window.lucide) lucide.createIcons();
    }

    function renderEvents(events) {
      const container = document.getElementById('events-feed-container');
      if (!events || events.length === 0) return;

      let html = '';
      events.forEach(evt => {
        html += `
          <div class="event-log-item">
            <div class="event-log-left">
              <span class="event-badge" style="background: rgba(229, 9, 20, 0.15); color: #ff4d58;">${evt.type}</span>
              <span style="color: #cbd5e1; font-weight: 600;">${evt.title}</span>
            </div>
            <span class="event-time">${new Date(evt.timestamp).toLocaleTimeString()}</span>
          </div>
        `;
      });
      container.innerHTML = html;
    }

    // Auto-polling interval (3 seconds)
    const pollInterval = setInterval(fetchStats, 3000);

    function triggerManualRefresh() {
      const btn = document.getElementById('refresh-btn');
      btn.style.opacity = '0.5';
      fetchStats().finally(() => {
        btn.style.opacity = '1';
      });
    }

    // Search / Filter
    function filterRooms() {
      const q = document.getElementById('search-input').value.toLowerCase().trim();
      const cards = document.querySelectorAll('.room-card');
      cards.forEach(card => {
        const code = (card.dataset.code || '').toLowerCase();
        const title = (card.dataset.title || '').toLowerCase();
        const host = (card.dataset.host || '').toLowerCase();
        if (!q || code.includes(q) || title.includes(q) || host.includes(q)) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // =========================================================================
    // ADMIN ACTIONS (KICK, CLOSE ROOM, BROADCAST)
    // =========================================================================
    async function kickMember(partyCode, userId, memberName) {
      if (!confirm(`Are you sure you want to kick ${memberName} from Party ${partyCode}?`)) return;

      try {
        const res = await fetch(`/user/admin/access/api/room/${partyCode}/kick`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId })
        });
        const data = await res.json();
        if (data.success) {
          fetchStats();
        } else {
          alert(data.error || 'Failed to kick member');
        }
      } catch (err) {
        alert('Network error: ' + err.message);
      }
    }

    async function terminateParty(partyCode) {
      if (!confirm(`Are you sure you want to forcibly END party ${partyCode}? All members will be disconnected.`)) return;

      try {
        const res = await fetch(`/user/admin/access/api/room/${partyCode}/close`, {
          method: 'POST'
        });
        const data = await res.json();
        if (data.success) {
          fetchStats();
        } else {
          alert(data.error || 'Failed to close party');
        }
      } catch (err) {
        alert('Network error: ' + err.message);
      }
    }

    // Broadcast Modal
    function openBroadcastModal(target) {
      document.getElementById('broadcast-target').value = target;
      document.getElementById('broadcast-target-label').innerText = target === 'ALL' ? 'Global (All Parties)' : `Party: ${target}`;
      document.getElementById('broadcast-message-text').value = '';
      document.getElementById('broadcast-modal').style.display = 'flex';
      document.getElementById('broadcast-message-text').focus();
    }

    function closeBroadcastModal() {
      document.getElementById('broadcast-modal').style.display = 'none';
    }

    async function submitBroadcast() {
      const target = document.getElementById('broadcast-target').value;
      const text = document.getElementById('broadcast-message-text').value.trim();
      if (!text) {
        alert('Please enter a message.');
        return;
      }

      try {
        const res = await fetch('/user/admin/access/api/broadcast', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ partyCode: target === 'ALL' ? null : target, message: text })
        });
        const data = await res.json();
        if (data.success) {
          closeBroadcastModal();
          fetchStats();
        }
      } catch (err) {
        alert('Failed to send broadcast: ' + err.message);
      }
    }
  </script>
</body>
</html>
