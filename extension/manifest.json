{
  "manifest_version": 3,
  "name": "Netflix Watch Party & Voice",
  "version": "1.0.0",
  "description": "Watch Netflix content together with friends in real-time sync with WebRTC voice chat and messaging.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.netflix.com/*",
    "http://localhost:5000/*",
    "ws://localhost:5000/*",
    "https://*/*",
    "wss://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Netflix Watch Party"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
